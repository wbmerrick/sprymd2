# Copy this file to ".env" and replace every value below with your real credentials.
# NEVER commit the real .env file to git.

PORT=3000

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# SendGrid (https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=SG.REPLACE_ME
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_TO_EMAIL=leads@yourdomain.com

# Session / security
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# Database (optional - e.g. Postgres/Mongo connection string)
DATABASE_URL=REPLACE_ME
